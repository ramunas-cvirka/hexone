<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="rescap uap">

  <Identity
    Name="@HEXONE_MSIX_IDENTITY_NAME@"
    Version="@HEXONE_MSIX_VERSION@"
    Publisher="@HEXONE_MSIX_PUBLISHER@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Hexone</DisplayName>
    <PublisherDisplayName>Ramūnas Cvirka</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Keyboard-driven file manager with a built-in viewer</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="Hexone"
      Executable="app\hexone.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Hexone"
        Description="Keyboard-driven file manager with a built-in viewer"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
